# Telegram: token from @BotFather
BOT_TOKEN=

# Who may use the bot. Your id: send /start to the bot without this set,
# or ask @userinfobot. Several ids: 111,222. Empty = anyone (not recommended).
OWNER_IDS=

TZ_NAME=Europe/Kyiv

# Public HTTPS address of the Mini App (see README). Empty = chat only.
WEBAPP_URL=
PORT=8080

# Assistant. Any one key is enough; Gemini has a free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible API works here (Groq, OpenRouter, a local Ollama):
OPENAI_BASE_URL=https://api.openai.com/v1

# Which one answers by default: gemini, claude or openai
AI_DEFAULT=gemini
