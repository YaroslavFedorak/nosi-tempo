# токен від @BotFather
BOT_TOKEN=

TZ_NAME=Europe/Kyiv

# ключ шифрування API-ключів користувачів (Fernet); якщо порожній, створиться data/secret.key
SECRET_KEY=

# моделі асистента через кому: якщо перша перевантажена, бот бере наступну
# ключі користувачі додають самі в боті
GEMINI_MODEL=gemini-flash-latest,gemini-3-flash-preview,gemini-flash-lite-latest
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5-mini
# підходить будь-яке OpenAI-сумісне API
OPENAI_BASE_URL=https://api.openai.com/v1
